{
  "$description": "Mallard design tokens: the one source of the website's colors, type and spacing (hooks/tokens.py writes them as CSS custom properties, --m-*, into assets/tokens.css at build time), for reuse by Mallard's GUI. Colors are sRGB hex; text colors meet WCAG AA (4.5:1) on bg, surface and surface-2 of their theme.",
  "font": {
    "sans": {"family": "Inter", "fallback": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif", "weights": [400, 500, 600, 700]},
    "mono": {"family": "JetBrains Mono", "fallback": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "weights": [400, 600]},
    "numeric": "tabular-nums",
    "features": "\"cv11\", \"ss01\""
  },
  "type": {
    "$description": "Sizes in px at the base size of 16 px; line heights unitless.",
    "display": {"size": 44, "line": 1.1, "weight": 650, "tracking": "-0.025em"},
    "h1": {"size": 32, "line": 1.2, "weight": 650, "tracking": "-0.02em"},
    "h2": {"size": 24, "line": 1.3, "weight": 600, "tracking": "-0.015em"},
    "h3": {"size": 19, "line": 1.4, "weight": 600, "tracking": "-0.01em"},
    "body": {"size": 16, "line": 1.65, "weight": 400, "tracking": "0"},
    "small": {"size": 14, "line": 1.5, "weight": 400, "tracking": "0"},
    "caption": {"size": 13, "line": 1.5, "weight": 400, "tracking": "0"},
    "label": {"size": 12, "line": 1.4, "weight": 600, "tracking": "0.06em"}
  },
  "space": {"$description": "A 4 px scale.", "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96},
  "radius": {"sm": 4, "md": 8, "lg": 12, "pill": 999},
  "color": {
    "light": {
      "bg": "#ffffff",
      "surface": "#f6f7f9",
      "surface-2": "#edf0f3",
      "border": "#dde2e7",
      "border-strong": "#c5ccd3",
      "text": "#10161c",
      "text-muted": "#4e5a66",
      "accent": "#0b6b63",
      "accent-hover": "#08554f",
      "accent-soft": "#0b6b6314",
      "on-accent": "#ffffff",
      "code-bg": "#f3f5f7",
      "code-text": "#1d2733",
      "focus": "#0b6b63",
      "danger": "#b42318",
      "warning": "#875a00",
      "success": "#17702f",
      "shadow": "0 1px 2px #10161c0f, 0 4px 16px #10161c0a"
    },
    "dark": {
      "bg": "#0b0f13",
      "surface": "#11161b",
      "surface-2": "#171e25",
      "border": "#232c35",
      "border-strong": "#33404c",
      "text": "#e6ebef",
      "text-muted": "#9aa6b2",
      "accent": "#4fc4b6",
      "accent-hover": "#79d6cb",
      "accent-soft": "#4fc4b61f",
      "on-accent": "#04201d",
      "code-bg": "#11171d",
      "code-text": "#d5dde4",
      "focus": "#79d6cb",
      "danger": "#ff7b72",
      "warning": "#d29922",
      "success": "#3fb950",
      "shadow": "0 1px 2px #0000004d, 0 8px 24px #00000040"
    }
  },
  "brand": {
    "$description": "The logo's colors, for the logo only; the interface uses the single accent above.",
    "plum": "#2b1a22",
    "flame": "#f28b1d",
    "teal": "#12655f"
  }
}
